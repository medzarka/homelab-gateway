# ==============================================================================
# Homelab Edge Gateway Ingress & SSO Configuration (.env)
# ==============================================================================

# --- 1. Host System User & Standard Data Directory ---
# The user on the host VM (e.g., mgrsys on VPS/Swarm, ubuntu on OCI)
SYSTEM_USER=mgrsys

# Master Data Root for persistent state (Follows template: /home/${SYSTEM_USER}/DATA/<stack-name>/data/<container-name>)
DATA_DIR=/home/${SYSTEM_USER}/DATA

# --- 2. Cloudflare ACME DNS Challenge (Wildcard SSL) ---
# Cloudflare API Token with "Zone:DNS:Edit" and "Zone:Zone:Read" permissions
CLOUDFLARE_API_TOKEN=your_cloudflare_dns_api_token_here

# Email registered for Let's Encrypt renewal notifications
ACME_EMAIL=admin@example.com

# Domain configuration
ROOT_DOMAIN=example.com

# --- 3. Cluster Interconnect Tailscale IPs ---
# Internal Tailscale IPs for cross-VM mesh dynamic proxying
TS_VM1_ZAP_VPS=100.x.y.z
TS_VM2_OCI01=100.x.y.z
TS_VM3_ORANGEPI=100.x.y.z

# --- 4. Shared Backbone Network ---
SHARED_NETWORK=shared_net
TZ=UTC

# --- 5. LLDAP Lightweight User Directory ---
LLDAP_JWT_SECRET=change_me_with_openssl_rand_hex_32
LLDAP_KEY_SEED=change_me_with_openssl_rand_hex_32
LLDAP_ADMIN_PASSWORD=adminpassword
LLDAP_BASE_DN=dc=example,dc=com

# --- 6. Authelia Dedicated LDAP Service Account ---
AUTHELIA_LDAP_USER=authelia
AUTHELIA_LDAP_PASSWORD=change_me_with_openssl_rand_hex_32
