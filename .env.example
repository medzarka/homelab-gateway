# ==============================================================================
# Homelab Edge Gateway Ingress & SSO Configuration (.env)
# ==============================================================================

# --- 1. Host System User & Standard Data Directory ---
# The user on the host VM (e.g., homelab on VPS/Swarm, ubuntu on Cloud)
SYSTEM_USER=homelab

# Master Data Root for persistent state (Follows template: /home/${SYSTEM_USER}/DATA/<stack-name>/data/<container-name>)
DATA_DIR=/home/${SYSTEM_USER}/DATA

# --- 2. Cloudflare ACME DNS Challenge (Wildcard SSL) ---
# Cloudflare API Token with "Zone:DNS:Edit" and "Zone:Zone:Read" permissions
CLOUDFLARE_API_TOKEN=your_cloudflare_dns_api_token_here

# Email registered for Let's Encrypt renewal notifications
ACME_EMAIL=admin@example.com

# Domain configuration
ROOT_DOMAIN=example.com

# --- 3. Cluster Backbone & Swarm Networks ---
SHARED_NETWORK=shared_net
SWARM_NETWORK=homelab_swarm_net
TZ=UTC

# --- 4. LLDAP Lightweight User Directory ---
LLDAP_JWT_SECRET=change_me_with_openssl_rand_hex_32
LLDAP_KEY_SEED=change_me_with_openssl_rand_hex_32
LLDAP_ADMIN_USER=admin
LLDAP_ADMIN_PASSWORD=adminpassword
LLDAP_BASE_DN=dc=example,dc=com
# Optional: Set to true only once if migrating/updating LLDAP_KEY_SEED or resetting admin password
LLDAP_FORCE_UPDATE_PRIVATE_KEY=false
LLDAP_FORCE_LDAP_USER_PASS_RESET=false

# --- 5. Authelia SMTP Notification Engine ---
# Used for sending password reset emails and device registration codes.
# If using Gmail/iCloud, you MUST use an App Password, not your standard password.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_SENDER="Homelab SSO <your_email@gmail.com>"
